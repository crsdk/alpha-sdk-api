{
  "name": "@alpha-sdk/crsdk",
  "version": "0.2.0",
  "description": "Developer CLI for the Alpha Camera REST API — build the native server from source, run it, and wire up docs MCP servers.",
  "type": "module",
  "bin": {
    "crsdk": "dist/bin/crsdk.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin/crsdk.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "sony",
    "camera",
    "alpha",
    "crsdk",
    "rest",
    "sdk",
    "cli",
    "tethering",
    "photography"
  ],
  "license": "MIT",
  "author": "Alpha Camera",
  "homepage": "https://github.com/crsdk/alpha-sdk-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crsdk/alpha-sdk-api.git"
  },
  "bugs": {
    "url": "https://github.com/crsdk/alpha-sdk-api/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "5.6.3"
  }
}
